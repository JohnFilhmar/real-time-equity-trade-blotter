<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The contracts the three services share: the gRPC proto, the JSON wire records, the broker message and the reference data.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\trades.proto" GrpcServices="Both" />
  </ItemGroup>

</Project>
