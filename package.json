{
  "name": "tp-icap-trade-blotter",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time equity trade blotter",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "docker compose up --build -d --wait",
    "stop": "docker compose down",
    "logs": "docker compose logs -f",
    "dev": "docker compose up --build",
    "dev:deps": "docker compose up -d --wait database redis",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build:shared && node scripts/with_build_env.mjs run build --workspace backend && npm run build --workspace frontend",
    "build:shared": "npm run build --workspace @blotter/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "node scripts/test_integration.mjs",
    "test:e2e": "npm run test:e2e --workspace frontend",
    "test:load": "k6 run load-testing/api_load.js",
    "test:lighthouse": "npm run test:lighthouse --workspace frontend",
    "test:all": "npm test && npm run test:integration && npm run test:e2e",
    "db:generate": "node scripts/with_build_env.mjs run prisma:generate --workspace backend",
    "db:migrate": "npm run prisma:migrate --workspace backend",
    "capture:readme": "npm run capture:readme --workspace frontend"
  }
}
