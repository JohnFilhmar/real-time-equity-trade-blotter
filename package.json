{
  "name": "trade-blotter",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time equity trade blotter",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "shared",
    "frontend"
  ],
  "scripts": {
    "start": "docker compose up --build -d --wait",
    "stop": "docker compose down",
    "logs": "docker compose logs -f",
    "dev": "docker compose up --build",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build:shared && npm run build --workspace frontend",
    "build:shared": "npm run build --workspace @blotter/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "pretest": "npm run build:shared",
    "test": "npm run test --workspaces --if-present",
    "test:services": "dotnet test --solution Blotter.slnx",
    "pretest:contract": "npm run build:shared",
    "test:contract": "node scripts/export_zod_cases.mjs --check",
    "test:e2e": "npm run test:e2e --workspace frontend",
    "test:load": "k6 run load-testing/api_load.js",
    "test:lighthouse": "npm run test:lighthouse --workspace frontend",
    "test:all": "npm test && npm run test:contract && npm run test:services && npm run test:e2e",
    "capture:readme": "npm run capture:readme --workspace frontend"
  }
}
