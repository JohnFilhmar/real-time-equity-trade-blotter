<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- CS1591 then fails the build on any public member without an XML doc comment. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- No InvariantGlobalization here: Microsoft.Data.SqlClient refuses to open a connection
         without ICU culture data, so only a service that never touches SQL Server turns it on. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Tests read as sentences (Amend_with_a_stale_version_is_a_conflict) and assert against literal
       arrays, so the two naming and allocation rules aimed at library code are off for them only. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CA1707;CA1861</NoWarn>
  </PropertyGroup>
</Project>
