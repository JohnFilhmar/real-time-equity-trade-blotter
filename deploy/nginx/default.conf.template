# The edge, and the only port the stack publishes. /api, /health and /ready go to the gateway,
# /hubs to the realtime service, and everything else to the web app. /metrics goes nowhere.
#
# The nginx image renders this template into conf.d at start, filling ${...} from the environment,
# so each service's address is configuration: moving one to another host is an edit to .env.
# Upstreams are looked up through the resolver at request time rather than once at start, so a
# service that restarts with a new address is found again without restarting nginx.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# One correlation id per request: the caller's when it sent one, otherwise nginx's own. The
# services accept it, log it and echo it back.
map $http_x_request_id $edge_request_id {
    default $http_x_request_id;
    ''      $request_id;
}

# The query string is left out on purpose: the hub's access token travels in it.
log_format edge '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                '$status $body_bytes_sent $request_time "$http_user_agent" $edge_request_id';

server {
    listen 8080 default_server;
    server_name _;

    access_log /dev/stdout edge;
    server_tokens off;

    # The gateway refuses bodies over 100 kB with a problem document of its own; this is only the
    # outer bound, so nginx never answers in its own HTML first.
    client_max_body_size 1m;

    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $gateway ${GATEWAY_UPSTREAM};
    set $realtime ${REALTIME_UPSTREAM};
    set $web ${WEB_UPSTREAM};

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Overwritten, not appended: the services trust exactly one hop, this one, so the address they
    # rate-limit by is the address that connected here.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $edge_request_id;
    proxy_set_header Connection "";

    location = /metrics {
        return 404;
    }

    location /api/ {
        proxy_pass http://$gateway;
    }

    location = /health {
        proxy_pass http://$gateway;
    }

    location = /ready {
        proxy_pass http://$gateway;
    }

    # SignalR: a WebSocket upgrade, or long polling where that is blocked. Both hold a request open,
    # so reads wait past the server's 90 second poll and its 15 second keep-alive.
    location /hubs/ {
        proxy_pass http://$realtime;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $edge_request_id;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location / {
        proxy_pass http://$web;
        proxy_hide_header X-Powered-By;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    }
}
