# Local runs without Docker. Copy to .env; the repository never writes .env for you.
# Compose carries its own values for the containers; it reads this file only for ${VAR} substitution.

# Database, owned by database/. The only thing the API needs to reach Postgres.
DATABASE_URL=postgresql://blotter:blotter@localhost:5432/blotter?schema=public
# The integration tier. Same server; the tests create and delete their own rows.
TEST_DATABASE_URL=postgresql://blotter:blotter@localhost:5432/blotter?schema=public

# Redis: sessions, login lockouts, rate-limit counters.
REDIS_URL=redis://localhost:6379
TEST_REDIS_URL=redis://localhost:6379

# API
PORT=5000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Refused under 32 characters. Development values, obviously so.
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
SEED_ON_STARTUP=true
SEED_TRADE_COUNT=500
SEED_USER_PASSWORD=blotter-demo-2026
# One switch for both simulations: the desk feed and the mark feed. 250 is the floor.
LIVE_FEED_ENABLED=true
LIVE_FEED_MIN_INTERVAL_MS=3000
LIVE_FEED_MAX_INTERVAL_MS=8000

# Web app. Baked into the Docker image at build time; read at runtime by next dev.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional, defaults shown. Uncomment to change.
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=604800
# BCRYPT_ROUNDS=12
# COOKIE_SECURE=false
# AUTH_RATE_LIMIT=10
# READ_RATE_LIMIT=300
# WRITE_RATE_LIMIT=60
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=900
# MAX_NOTIONAL_USD=50000000
# MAX_NOTIONAL_GBX=4000000000
# SHUTDOWN_TIMEOUT_MS=10000

# Compose only: container credentials and host ports.
# POSTGRES_USER=blotter
# POSTGRES_PASSWORD=blotter
# POSTGRES_DB=blotter
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# BACKEND_PORT=5000
# FRONTEND_PORT=3000